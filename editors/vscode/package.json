{
  "name": "gesu",
  "displayName": "Gesù",
  "description": "Gesù language support: syntax colors, errors as you type, completion and hover. There is only one Truth, Jesus.",
  "version": "0.1.0",
  "publisher": "lschiavini",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "gesu",
        "aliases": [
          "Gesù",
          "gesu"
        ],
        "extensions": [
          ".gesu"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gesu",
        "scopeName": "source.gesu",
        "path": "./syntaxes/gesu.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Gesù",
      "properties": {
        "gesu.path": {
          "type": "string",
          "default": "gesu",
          "description": "Path to the gesu binary. It serves the editor with `gesu lsp`."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lschiavini/gesu.git",
    "directory": "editors/vscode"
  },
  "homepage": "https://gesu.lucas-schiavini.com"
}
